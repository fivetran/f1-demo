# Copy to .env; keep live account settings and credentials out of Git.
F1_GCP_PROJECT=your-gcp-project
F1_BQ_LOCATION=US
F1_DBT_DATASET=f1
F1_OPENF1_DATASET=f1_openf1
F1_DOCUMENTS_DATASET=f1_documents
# Fivetran API credentials belong to the NEW account, never an existing account.
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
F1_OPENF1_CONNECTION_ID=YOUR_OPENF1_CONNECTION_ID
F1_DOCUMENTS_CONNECTION_ID=YOUR_DOCUMENTS_CONNECTION_ID
F1_DBT_SERVICE_ACCOUNT=your-dbt-service-account@your-gcp-project.iam.gserviceaccount.com
